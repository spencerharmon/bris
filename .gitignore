# Build artifacts
target/
**/target/
*.rs.bk
Cargo.lock.bak

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.#*
\#*\#

# Agent / shell artifacts
.agent-shell/

# OS
.DS_Store
Thumbs.db

# Local config / secrets
.env
.env.local
*.local.toml

# Logs / databases (dev)
*.log
*.sqlite
*.sqlite-journal
*.db

# Mobile build artifacts. The Bris Android shell lives under
# bris-android/ and has its own .gitignore covering build/,
# .gradle/, jniLibs/, and local.properties; these patterns
# are belt-and-suspenders.
bris-android/.gradle/
bris-android/build/
bris-android/app/build/
bris-android/local.properties
bris-android/app/src/main/jniLibs/
ios/build/
ios/Pods/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/

# Collector dev runtime data (when running locally without
# docker-compose's named volume).
collector-data/

# Generated UniFFI bindings
**/generated/

# Vendored upstream data files re-fetched by scripts/import_*.
# Checked-in TSVs in crates/bris-almanac/data/ are the source of truth
# for the build; the raw upstream files in scripts/data/ are working
# copies of the importer.
scripts/data/

# Pretrained segmentation model. Regenerate with
# `python3 scripts/export_segformer_ade.py crates/bris-vision/data/segmentation.onnx \
#  crates/bris-vision/data/segmentation_labels.json`.
# Eventually this will ship via the bris-data OTA channel.
crates/bris-vision/data/segmentation.onnx
crates/bris-vision/data/segmentation_labels.json
test_video/
tmp/

# User-provided calibration captures (working drop-zone for
# bris-cli calibrate experiments). Curated subsets that should
# round-trip in CI are promoted into a regression-test case.
calibration/
